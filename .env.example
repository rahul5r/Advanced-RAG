# Google Gemini
GOOGLE_API_KEY=your_key_here
MODEL_NAME=gemini-2.0-flash
EMBEDDING_MODEL=models/text-embedding-004

# FAISS & BM25 Index Paths
FAISS_INDEX_PATH=data/indexes/faiss.index
FAISS_METADATA_PATH=data/indexes/metadata.json
BM25_INDEX_PATH=data/indexes/bm25.pkl

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Retrieval
# Options: dense | hybrid | expansion | rerank | self_query | multi_hop
RETRIEVAL_STRATEGY=dense
TOP_K=3

# Hybrid Search: weight between semantic (1.0) and keyword (0.0)
HYBRID_ALPHA=0.6

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# RAGAS Evaluation Thresholds
RAGAS_FAITHFULNESS_THRESHOLD=0.80
RAGAS_CONTEXT_RECALL_THRESHOLD=0.70

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
